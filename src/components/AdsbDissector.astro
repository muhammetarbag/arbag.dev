---
// AdsbDissector.astro — 112-bit Mode-S / ADS-B (DF17/18) frame dissector with real CRC-24 check
---

<div class="hardware-card" id="adsb-tool">
  <div class="hardware-card-inner space-y-6">
    <div class="specular-line"></div>

    <!-- Header & Status -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/[0.08] pb-4">
      <div class="space-y-1 min-w-0">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#00e5ff] shadow-[0_0_8px_#00e5ff] animate-pulse" aria-hidden="true"></span>
          <span class="text-xs font-mono font-bold text-white uppercase tracking-wider">
            ADS-B // MODE-S ÇERÇEVE ÇÖZÜCÜ
          </span>
        </div>
        <p class="text-[11px] text-neutral-400 font-mono">
          112-bit Extended Squitter (DF17/18) ayrıştırma ve CRC-24 sağlama. RF yakalama içermez: girdi, demodüle edilmiş hex çerçevedir.
        </p>
      </div>

      <div class="flex items-center gap-2 text-xs font-mono min-w-0 max-w-full">
        <label for="adsb-preset-select" class="text-neutral-400 shrink-0">Örnek çerçeve:</label>
        <select
          id="adsb-preset-select"
          class="min-w-0 max-w-full bg-[#090b10] border border-white/10 rounded px-2.5 py-1 text-xs text-white font-mono focus:border-[#00e5ff] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#00e5ff]"
        >
          <option value="ident">Kimlik (TC4) — KLM1023</option>
          <option value="alt">Konum / irtifa (TC11) — 38.000 ft</option>
          <option value="vel">Hız (TC19) — 159 kt, 183°</option>
        </select>
      </div>
    </div>

    <!-- Raw Hex Packet Input & CRC Checker -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 p-4 rounded-xl bg-black/50 border border-white/[0.06]">
      <div class="lg:col-span-8 space-y-2 font-mono text-xs">
        <div class="flex items-center justify-between text-[11px] text-neutral-400">
          <label for="adsb-hex-input">HAM 112-BIT MODE-S ÇERÇEVESİ (28 HEX HANESİ):</label>
        </div>

        <div class="relative">
          <input
            type="text"
            id="adsb-hex-input"
            value="8D4840D6202CC371C32CE0576098"
            maxlength="28"
            spellcheck="false"
            autocomplete="off"
            aria-describedby="adsb-msg"
            class="w-full bg-[#07080b] border border-white/15 focus:border-[#00e5ff] rounded-lg px-3 py-2 text-xs font-mono text-[#00e5ff] tracking-wider uppercase focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#00e5ff]"
          />
        </div>

        <p id="adsb-msg" class="min-h-[1rem] text-[11px] text-neutral-400" aria-live="polite"></p>

        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-[11px] text-neutral-400 pt-1">
          <span>Bit Uzunluğu: <strong class="text-white" id="packet-bit-len">112 BİT</strong></span>
          <span>Frekans: <strong class="text-neutral-300">1090 MHz (ADS-B)</strong></span>
          <span>Kaynak: <strong class="text-neutral-300">hex girdi</strong></span>
        </div>
      </div>

      <!-- CRC & Integrity Check Box -->
      <div class="lg:col-span-4 flex flex-col justify-between p-3.5 rounded-lg bg-black/60 border border-white/10 font-mono text-xs space-y-2">
        <div class="flex items-center justify-between text-[11px] text-neutral-400">
          <span>CRC-24 SAĞLAMA</span>
          <span class="text-[#00e676] font-bold" id="crc-status">GEÇERLİ</span>
        </div>
        <div class="text-lg font-bold text-white tracking-wider flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#00e676]" id="crc-dot" aria-hidden="true"></span>
          <span id="crc-hex-display">CRC: 0x576098</span>
        </div>
        <div class="text-[11px] text-neutral-400 border-t border-white/5 pt-1.5 flex justify-between gap-2">
          <span>Polinom: <strong class="text-neutral-300">0xFFF409</strong></span>
          <span>Hesaplanan: <strong class="text-neutral-300" id="crc-calc">0x576098</strong></span>
        </div>
      </div>
    </div>

    <!-- Decoded Avionics Telemetry Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 font-mono text-xs">

      <!-- Field 1: Downlink Format & CA -->
      <div class="p-3.5 rounded-xl bg-black/40 border border-white/[0.06] space-y-1.5">
        <div class="text-[11px] text-neutral-400 uppercase">DOWNLINK FORMAT (DF)</div>
        <div class="text-base font-bold text-[#00e5ff]" id="df-val">DF 17 (Extended Squitter)</div>
        <div class="text-[11px] text-neutral-400">Yetenek (CA): <span class="text-white" id="ca-val">—</span></div>
      </div>

      <!-- Field 2: ICAO 24-Bit Address -->
      <div class="p-3.5 rounded-xl bg-black/40 border border-white/[0.06] space-y-1.5">
        <div class="text-[11px] text-neutral-400 uppercase">ICAO 24-BİT HAVA TAŞITI ADRESİ</div>
        <div class="text-base font-bold text-white tracking-wider" id="icao-val">0x4840D6</div>
        <div class="text-[11px] text-neutral-400">Not: <span class="text-white" id="reg-val">ülke/tescil çözümü yok</span></div>
      </div>

      <!-- Field 3: Type Code & Callsign -->
      <div class="p-3.5 rounded-xl bg-black/40 border border-white/[0.06] space-y-1.5">
        <div class="text-[11px] text-neutral-400 uppercase">TİP KODU &amp; ÇAĞRI KODU</div>
        <div class="text-base font-bold text-amber-400" id="callsign-val">—</div>
        <div class="text-[11px] text-neutral-400">Mesaj Tipi: <span class="text-white" id="type-code-val">—</span></div>
      </div>

      <!-- Field 4: Kinematic Status -->
      <div class="p-3.5 rounded-xl bg-black/40 border border-white/[0.06] space-y-1.5">
        <div class="text-[11px] text-neutral-400 uppercase">BAROMETRİK İRTİFA &amp; HIZ</div>
        <div class="text-base font-bold text-[#00e676]" id="kinematic-val">—</div>
        <div class="text-[11px] text-neutral-400">Dikey Oran: <span class="text-white" id="vs-val">—</span></div>
      </div>

    </div>

    <!-- Packet Bitfield Visualizer (112 Bits) -->
    <div class="space-y-2 font-mono">
      <div class="flex flex-wrap items-center justify-between gap-1 text-[11px] text-neutral-400">
        <span>112-BIT PROTOKOL KATMANI DİLİMLEMESİ:</span>
        <span class="text-[11px] text-neutral-400">DF (1-5) | CA (6-8) | ICAO (9-32) | ME VERİ (33-88) | PI/CRC (89-112)</span>
      </div>

      <div class="w-full h-3 rounded-full bg-white/5 border border-white/10 flex overflow-hidden">
        <div class="h-full bg-purple-500/80 w-[4.46%]" title="DF: Bits 1-5"></div>
        <div class="h-full bg-pink-500/80 w-[2.68%]" title="CA: Bits 6-8"></div>
        <div class="h-full bg-blue-500/80 w-[21.43%]" title="ICAO Address: Bits 9-32"></div>
        <div class="h-full bg-cyan-500/80 w-[50.00%]" title="ME Message: Bits 33-88"></div>
        <div class="h-full bg-emerald-500/80 w-[21.43%]" title="Parity/CRC: Bits 89-112"></div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-2 text-[11px] text-neutral-400 pt-1">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-purple-500"></span>
          <span>DF (5b)</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-pink-500"></span>
          <span>CA (3b)</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          <span>ICAO 24b Adres</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
          <span>ME 56b Aviyonik Veri Yükü</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>PI / CRC 24b Sağlama</span>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  import { decodeFrame } from '../lib/modes.ts';

  // Reference frames from "The 1090 MHz Riddle" (J. Sun).
  const presets: Record<string, string> = {
    ident: '8D4840D6202CC371C32CE0576098',
    alt: '8D40621D58C382D690C8AC2863A7',
    vel: '8D485020994409940838175B284F',
  };

  const CA_TEXT: Record<number, string> = {
    0: 'Level 0',
    4: 'Level 2+ (yerde)',
    5: 'Level 2+ (havada)',
    6: 'Level 2+ (yerde/havada)',
    7: 'DR≠0 veya FS 2–5',
  };

  function typeCodeText(tc: number): string {
    if (tc >= 1 && tc <= 4) return `TC=${tc} (Uçuş Kimliği)`;
    if (tc >= 5 && tc <= 8) return `TC=${tc} (Yüzey Konumu)`;
    if (tc >= 9 && tc <= 18) return `TC=${tc} (Havada Konum, barometrik)`;
    if (tc === 19) return `TC=${tc} (Havada Hız)`;
    if (tc >= 20 && tc <= 22) return `TC=${tc} (Havada Konum, GNSS)`;
    if (tc === 28) return `TC=${tc} (Uçak Durumu)`;
    if (tc === 31) return `TC=${tc} (Operasyonel Durum)`;
    return `TC=${tc} (Diğer)`;
  }

  const $ = (id: string) => document.getElementById(id);
  const presetSelect = $('adsb-preset-select') as HTMLSelectElement | null;
  const hexInput = $('adsb-hex-input') as HTMLInputElement | null;
  const msg = $('adsb-msg');
  const bitLen = $('packet-bit-len');
  const crcStatus = $('crc-status');
  const crcDot = $('crc-dot');
  const crcHex = $('crc-hex-display');
  const crcCalc = $('crc-calc');
  const fields = {
    df: $('df-val'), ca: $('ca-val'), icao: $('icao-val'), reg: $('reg-val'),
    callsign: $('callsign-val'), tc: $('type-code-val'), kin: $('kinematic-val'), vs: $('vs-val'),
  };

  const TONES = ['text-[#00e676]', 'text-red-400', 'text-amber-400'];
  const DOT_TONES = ['bg-[#00e676]', 'bg-red-400', 'bg-amber-400'];

  function setTone(el: HTMLElement | null, dot: boolean, tone: 0 | 1 | 2) {
    if (!el) return;
    const all = dot ? DOT_TONES : TONES;
    el.classList.remove(...all);
    el.classList.add(all[tone]);
  }

  function setText(el: HTMLElement | null, text: string) {
    if (el) el.textContent = text;
  }

  const hex = (n: number, width: number) => '0x' + n.toString(16).toUpperCase().padStart(width, '0');

  function clearFields() {
    for (const el of Object.values(fields)) setText(el, '—');
    setText(fields.reg, 'ülke/tescil çözümü yok');
    setText(crcHex, 'CRC: —');
    setText(crcCalc, '—');
  }

  function render() {
    if (!hexInput) return;
    const raw = hexInput.value.trim();
    setText(bitLen, `${raw.length * 4} BİT`);
    const frame = decodeFrame(raw);

    if (!frame.valid) {
      clearFields();
      setText(crcStatus, 'GİRDİ GEÇERSİZ');
      setTone(crcStatus, false, 2);
      setTone(crcDot, true, 2);
      setText(msg, raw.length === 0 ? 'Bir hex çerçeve girin veya örnek seçin.' : `${frame.error} (${raw.length}/28).`);
      return;
    }

    setText(fields.df, `DF ${frame.df}${frame.df === 17 ? ' (Extended Squitter)' : frame.df === 18 ? ' (TIS-B / ADS-R)' : ''}`);
    setText(fields.ca, `CA ${frame.ca} — ${CA_TEXT[frame.ca] ?? 'ayrılmış'}`);
    setText(fields.icao, '0x' + frame.icao);
    setText(fields.reg, 'ülke/tescil çözümü yok');

    // Other downlink formats are not ADS-B: ME fields and the plain CRC check do not apply.
    if (frame.df !== 17 && frame.df !== 18) {
      for (const el of [fields.tc, fields.callsign, fields.kin, fields.vs]) setText(el, '—');
      setText(crcHex, `PI: ${hex(frame.crcReceived, 6)}`);
      setText(crcCalc, '—');
      setText(crcStatus, 'DESTEKLENMİYOR');
      setTone(crcStatus, false, 2);
      setTone(crcDot, true, 2);
      setText(msg, frame.error ?? '');
      return;
    }

    setText(fields.tc, typeCodeText(frame.typeCode));
    setText(fields.callsign, frame.callsign ?? '—');
    setText(
      fields.kin,
      frame.altitudeFt !== undefined
        ? `${frame.altitudeFt.toLocaleString('en-US')} FT`
        : frame.speedKt !== undefined
          ? `${Math.round(frame.speedKt)} KTS • ${Math.round(frame.headingDeg ?? 0)}°`
          : '—',
    );
    setText(
      fields.vs,
      frame.verticalRateFpm !== undefined
        ? `${frame.verticalRateFpm > 0 ? '+' : ''}${frame.verticalRateFpm} FPM`
        : frame.altitudeFt !== undefined
          ? 'konum (CPR) çözülmez'
          : '—',
    );
    setText(crcHex, `CRC: ${hex(frame.crcReceived, 6)}`);
    setText(crcCalc, hex(frame.crcComputed, 6));

    const ok = frame.crcOk;
    setText(crcStatus, ok ? 'GEÇERLİ' : 'GEÇERSİZ');
    setTone(crcStatus, false, ok ? 0 : 1);
    setTone(crcDot, true, ok ? 0 : 1);
    setText(
      msg,
      frame.error ??
        (ok ? '' : 'CRC uyuşmuyor: çerçeve bozuk. Aşağıdaki alanlar güvenilir değildir.'),
    );
  }

  presetSelect?.addEventListener('change', () => {
    const frame = presets[presetSelect.value];
    if (frame && hexInput) {
      hexInput.value = frame;
      render();
    }
  });

  hexInput?.addEventListener('input', render);
  render();
</script>
