---
// CommandPalette.astro — HUD Flight Terminal & Interactive Quick Command Palette
---

<!-- Trigger Button Floating in Bottom-Right -->
<div class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40">
  <button
    id="open-terminal-btn"
    class="group flex items-center gap-2.5 px-3.5 py-2 rounded-full border border-white/10 bg-[#090b10]/90 backdrop-blur-xl text-xs font-mono text-neutral-300 hover:text-white hover:border-[#00e5ff]/50 shadow-[0_10px_25px_rgba(0,0,0,0.8)] active:scale-[0.98] transition-all"
    title="Aviyonik Komuta Konsolunu Aç (Kısayol: ~ veya ⌘K)"
    aria-label="Komut konsolunu aç"
  >
    <span class="w-2 h-2 rounded-full bg-[#00e5ff] shadow-[0_0_6px_#00e5ff] animate-ping" aria-hidden="true"></span>
    <span class="font-bold tracking-wider">[ ⌘K<span class="hidden sm:inline"> / KONSOL</span> ]</span>
    <span class="text-[11px] text-neutral-400 hidden sm:inline">CLI</span>
  </button>
</div>

<!-- Terminal Modal Overlay -->
<div
  id="terminal-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Komut konsolu"
  inert
  class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-200"
>
  <div class="relative w-full max-w-2xl rounded-2xl border border-white/15 bg-[#07090d] shadow-2xl overflow-hidden font-mono text-xs flex flex-col max-h-[85vh]">
    <!-- Terminal Header Bar -->
    <div class="flex items-center justify-between px-4 py-2.5 border-b border-white/10 bg-black/60 select-none">
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80 inline-block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-green-500/80 inline-block"></span>
        </div>
        <span class="text-[11px] text-neutral-400 font-semibold pl-2">
          arbag.dev ~ komut konsolu
        </span>
      </div>

      <button
        id="close-terminal-btn"
        class="text-neutral-400 hover:text-white text-xs px-2 py-0.5 rounded border border-white/5 hover:border-white/20 transition-colors"
      >
        ESC
      </button>
    </div>

    <!-- Terminal Output Log -->
    <div id="terminal-output" class="p-4 overflow-y-auto space-y-2 flex-1 text-[11px] text-neutral-300 min-h-[220px]">
      <div class="text-[#00e5ff] font-bold">
        ARBAG.DEV KOMUT KONSOLU
      </div>
      <div class="text-neutral-400">
        Kullanılabilir komutlar: <span class="text-white">ai</span>, <span class="text-white">embedded</span>, <span class="text-white">lab</span>, <span class="text-white">arinc</span>, <span class="text-white">vtol</span>, <span class="text-white">qrh</span>, <span class="text-white">adsb</span>, <span class="text-white">cv</span>, <span class="text-white">clear</span>, <span class="text-white">exit</span>
      </div>
    </div>

    <!-- Terminal Command Input Line -->
    <div class="flex items-center gap-2 px-4 py-3 border-t border-white/10 bg-black/40">
      <span class="text-[#00e676] font-bold">$</span>
      <input
        type="text"
        id="terminal-input"
        autocomplete="off"
        spellcheck="false"
        placeholder="Bir komut yazın (örn: lab, arinc, cv)..."
        aria-label="Komut"
        class="flex-1 bg-transparent text-white font-mono text-xs outline-none placeholder:text-neutral-400 focus-visible:underline decoration-[#00e5ff]"
      />
    </div>
  </div>
</div>

<script>
  const openBtn = document.getElementById('open-terminal-btn');
  const closeBtn = document.getElementById('close-terminal-btn');
  const modal = document.getElementById('terminal-modal');
  const input = document.getElementById('terminal-input') as HTMLInputElement;
  const output = document.getElementById('terminal-output');

  function openTerminal() {
    if (modal && input) {
      modal.removeAttribute('inert');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      input.focus();
    }
  }

  function closeTerminal() {
    if (modal) {
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.setAttribute('inert', '');
      openBtn?.focus();
    }
  }

  // Scroll to a lab widget; those only exist on /lab, so jump there from other pages.
  function goToLabTool(id: string) {
    if (window.location.pathname.replace(/\/$/, '') === '/lab') {
      document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
    } else {
      window.location.href = `/lab/#${id}`;
    }
  }

  if (openBtn && closeBtn && modal && input && output) {
    openBtn.addEventListener('click', openTerminal);
    closeBtn.addEventListener('click', closeTerminal);

    // Global Keyboard Shortcuts (⌘K, Ctrl+K, or ~)
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        modal.classList.contains('opacity-0') ? openTerminal() : closeTerminal();
      } else if (e.key === '`' || e.key === '~') {
        const tag = document.activeElement?.tagName;
        if (tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') {
          e.preventDefault();
          modal.classList.contains('opacity-0') ? openTerminal() : closeTerminal();
        }
      } else if (e.key === 'Escape' && !modal.classList.contains('opacity-0')) {
        closeTerminal();
      }
    });

    // Handle Commands
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const cmd = input.value.trim().toLowerCase();
        input.value = '';
        if (!cmd) return;

        const cmdLine = document.createElement('div');
        const prompt = document.createElement('span');
        prompt.className = 'text-[#00e676] font-bold';
        prompt.textContent = '$';
        const typed = document.createElement('span');
        typed.className = 'text-white';
        typed.textContent = ` ${cmd}`;
        cmdLine.append(prompt, typed);
        output.appendChild(cmdLine);

        const resp = document.createElement('div');
        resp.className = 'text-neutral-400 pl-3 leading-relaxed';

        switch (cmd) {
          case 'help':
            resp.innerHTML = `
              <strong>KULLANILABİLİR KOMUTLAR:</strong><br/>
              • <span class="text-white">ai</span>       : Yapay Zeka ve Ajan Mimarileri bölümüne gider.<br/>
              • <span class="text-white">embedded</span> : Gömülü Sistemler ve Düşük Seviye Yazılım bölümüne gider.<br/>
              • <span class="text-white">lab</span>      : Canlı Aviyonik &amp; Donanım Laboratuvarını (/lab) açar.<br/>
              • <span class="text-white">arinc</span> / <span class="text-white">vtol</span> / <span class="text-white">qrh</span> / <span class="text-white">adsb</span> : İlgili lab aracına gider.<br/>
              • <span class="text-white">cv</span>       : Düz metin mühendislik özgeçmişini açar.<br/>
              • <span class="text-white">clear</span>    : Konsol ekranını temizler.<br/>
              • <span class="text-white">exit</span>     : Terminali kapatır.
            `;
            break;

          case 'ai':
            resp.innerText = 'Yapay Zeka ve Ajan Sistemlerine yönlendiriliyor...';
            closeTerminal();
            if (window.location.pathname !== '/') {
              window.location.href = '/#yazilim-ai';
            } else {
              document.getElementById('yazilim-ai')?.scrollIntoView({ behavior: 'smooth' });
            }
            break;

          case 'embedded':
            resp.innerText = 'Gömülü Sistemler ve Düşük Seviye Yazılıma yönlendiriliyor...';
            closeTerminal();
            if (window.location.pathname !== '/') {
              window.location.href = '/#gomulu-sistem';
            } else {
              document.getElementById('gomulu-sistem')?.scrollIntoView({ behavior: 'smooth' });
            }
            break;

          case 'lab':
            resp.innerText = 'Canlı Aviyonik & Donanım Laboratuvarı açılıyor...';
            closeTerminal();
            window.location.href = '/lab';
            break;

          case 'arinc':
            resp.innerText = 'ARINC 429 Ayrıştırıcısına yönlendiriliyor...';
            closeTerminal();
            goToLabTool('arinc-tool');
            break;

          case 'vtol':
            resp.innerText = 'ARK-04 VTOL Simülatörüne yönlendiriliyor...';
            closeTerminal();
            goToLabTool('vtol-spec');
            break;

          case 'qrh':
            resp.innerText = 'QRH kontrol listesi prototipine yönlendiriliyor...';
            closeTerminal();
            goToLabTool('qrh-tool');
            break;

          case 'adsb':
            resp.innerText = 'ADS-B çerçeve çözücüye yönlendiriliyor...';
            closeTerminal();
            goToLabTool('adsb-tool');
            break;

          case 'labs':
            resp.innerText = 'ATA laboratuvar matrisine kaydırılıyor...';
            closeTerminal();
            goToLabTool('laboratuvarlar');
            break;

          case 'cv':
            resp.innerText = 'Özgeçmiş açılıyor...';
            window.open('/cv.txt', '_blank');
            break;

          case 'clear':
            output.innerHTML = '';
            return;

          case 'exit':
            closeTerminal();
            return;

          default:
            resp.textContent = `Komut bulunamadı: "${cmd}". Yardım için help yazın.`;
            resp.classList.add('text-red-400');
        }

        output.appendChild(resp);
        output.scrollTop = output.scrollHeight;
      }
    });
  }
</script>
