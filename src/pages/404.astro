---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Sayfa bulunamadı" description="Aradığınız sayfa bulunamadı.">
  <section class="max-w-2xl mx-auto px-6 py-24 font-mono space-y-6">
    <div class="text-[11px] text-[#00e5ff] font-semibold tracking-wider">HATA 404</div>
    <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">Sayfa bulunamadı.</h1>
    <p class="text-sm text-neutral-300 leading-relaxed">
      Bu adreste bir sayfa yok. Ana sayfaya ya da laboratuvara dönebilirsiniz.
    </p>
    <div class="flex flex-wrap gap-3 text-xs">
      <a href="/" class="px-4 py-2 rounded-full border border-white/10 bg-white/[0.04] text-neutral-200 hover:text-white hover:border-[#00e5ff]/40 transition-colors">Ana sayfa</a>
      <a href="/lab/" class="px-4 py-2 rounded-full border border-[#00e5ff]/40 bg-[#00e5ff]/10 text-[#00e5ff] hover:text-white transition-colors">Laboratuvar</a>
    </div>
  </section>
</Layout>
