    desc: "ARM Cortex-M7/M4 işlemcilerde koşan, statik bellek tahsisli, ARINC 653 ilkeli bölümlendirilmiş deterministik mikroçekirdek mimarisi.",
    tech: ["C99 / ASM", "STM32H7 Dual-Core", "Rate Monotonic Scheduling", "MPU İzolasyonu", "DO-178C"],
    status: "ÇEKİRDEK KODLAMA",
    statusColor: "emerald",
    highlight: "Kritik 100 Hz uçuş döngüleri için deterministik WCET garantisi."
  },
  {
    tag: "GÖMÜLÜ LINUX // TERSİNE MÜHENDİSLİK",
    title: "Hermes-Edge: Tizen OS & ARM Donanım Tersine Mühendislik Laboratuvarı",
    desc: "Eski nesil akıllı ekranlar ve özel aviyonik terminaller için firmware çıkarma, UART/eMMC donanım tap'leme ve düşük seviye ikili yama araç takımı.",
    tech: ["Ghidra / Rizin", "UART / JTAG", "ARM Assembly", "Squashfs Unpack", "C++ Media Core"],
    status: "AÇIK KAYNAK ARAÇ KİTİ",
    statusColor: "purple",
    highlight: "512 MB kısıtlı RAM donanımlarda sıfır sızıntılı C++ medya boru hattı."
