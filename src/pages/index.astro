const upcomingProjects = [
  {
    tag: "RF & SDR // CANLI PROTOKOL",
    title: "AEE-SDR: Open-Source 1090 MHz Mode-S & ADS-B Yer İstasyonu",
    desc: "RTL-SDR ve HackRF tabanlı, 1090 MHz Extended Squitter (DF17/18) ICAO yayınlarını doğrudan RF demodülasyonu ile çözen açık kaynaklı hava gözetleme hattı.",
    tech: ["RTL-SDR", "Python DSP", "CRC-24 DO-260B", "PPM Demodülatör", "Leaflet Radar"],
    status: "DONANIM TESTİNDE",
    statusColor: "cyan",
    highlight: "2 MHz I/Q örnekleme ile sıfır gecikmeli irtifa ve vektör tespiti."
  },
  {
    tag: "ASKERİ AVİYONİK // SAVUNMA",
