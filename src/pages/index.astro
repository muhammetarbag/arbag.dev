---
import Layout from '../layouts/Layout.astro';
import CommandPalette from '../components/CommandPalette.astro';

const aiProjects = [
  {
    tag: "AJAN MİMARİSİ // DETERMINISTIC AI",
    title: "Hermes & Avenox: Grunt vs. Judgment Ajan Modeli",
    desc: "LLM'lerin halüsinasyon ve bağlam şişmesi (context rot) riskini azaltmayı hedefleyen iki kademeli karar mimarisi. Veri toplama deterministik shell/kod araçlarıyla (Grunt) LLM token'ı harcamadan yapılır; yüksek akıl yürütme (Judgment) modeline yalnızca filtrelenmiş karar matrisi iletilir.",
    metrics: ["Deterministik Toplama", "Filtrelenmiş Girdi", "Deterministik Sentez"],
    tech: ["Python Asyncio", "Deterministic Filters", "Tool-Calling", "Context Guardrails"]
  },
  {
    tag: "EMNİYET VE ONAY // SAFETY GATE",
    title: "Draft-Gate: İki Kademeli Durum Mutasyon Protokolü",
    desc: "Otonom ajanların harici sistemleri kontrolsüz değiştirmesini önlemek için tasarlanmış 'Draft-Only' yayınlama mimarisi. Dış dünyaya etki eden, geri döndürülemez eylemler (dosya yazma, durum değiştirme, donanım komutu) operatör onayı ve işlem makbuzu olmadan yürütülmemesi hedefiyle kapı arkasına alınır.",
    metrics: ["Operatör Makbuzu", "Geri Alınabilir Durum", "Fail-Safe Default"],
    tech: ["Audit Trail", "Human-in-the-Loop", "State Machine", "Approval Gates"]
  },
  {
    tag: "AVİYONİK AI // EĞİTİM PROTOTİPİ",
    title: "Hermes-Avionics: Kural Tabanlı Kokpit Karar Destek Prototipi",
    desc: "QRH prosedürlerinden ve arıza izolasyon el kitaplarından (FIM) esinlenen, kural ağacıyla çalışan eğitim prototipi. Çift jeneratör kaybı, kabin dekompresyonu gibi senaryolarda adım adım kontrol listesi sunar. Sertifikalı bir sistem değildir ve DO-178C kapsamında geliştirilmemiştir.",
    metrics: ["Kural Tabanlı", "Hata Ağacı", "Eğitim Prototipi"],
    tech: ["Deterministic Logic", "Fault Trees", "QRH Checklists", "Web Demo"]
  }
];

const systemsProjects = [
  {
    tag: "SMART TV // PLUGIN MİMARİSİ",
    title: "MHATv: Samsung Tizen TV için Eklenti Tabanlı Uygulama",
    desc: "Samsung Tizen TV için CloudStream benzeri, dinamik eklenti (plugin) tabanlı bir uygulama. Eski nesil, düşük bellekli TV'lerde çalışacak şekilde tasarlandı. Kaynak kodu private; ayrıntılar görüşmede paylaşılabilir.",
    metrics: ["Tizen Web", "Plugin Mimarisi", "Kısıtlı Bellek"],
    tech: ["Tizen OS", "JavaScript", "Plugin Sistemi"]
  },
  {
    tag: "RF / ADS-B // TARAYICI ARACI",
    title: "ADS-B Mode-S Çerçeve Çözücü",
    desc: "112-bit Mode-S / ADS-B (DF17) çerçevelerini tarayıcıda ayrıştıran ve CRC-24 sağlamasını hesaplayan eğitim aracı. Ham hex girin; ICAO adresi, çağrı kodu, irtifa ve hız çözülür. /lab sayfasında canlı çalışır. RF yakalama veya SDR donanımı kullanmaz.",
    metrics: ["DF17 Çözümleme", "CRC-24", "1090 MHz Formatı"],
    tech: ["JavaScript", "Mode-S", "ADS-B", "ICAO Annex 10"]
  },
  {
    tag: "GÖMÜLÜ LINUX // ÇALIŞMA ALANI",
    title: "Linux IPC & Gerçek Zamanlı Sistemler",
    desc: "Çalışma alanı: POSIX paylaşımlı bellek (shm), mesaj kuyrukları ve soket IPC katmanları; FreeRTOS ve STM32 mikrodenetleyiciler üzerinde Rate Monotonic Scheduling (RMS) görev zamanlaması. Henüz yayımlanmış bir ölçüm veya kod deposu yok.",
    metrics: ["POSIX shm", "Mesaj Kuyruğu", "RMS Zamanlama"],
    tech: ["Linux", "FreeRTOS", "POSIX IPC", "STM32", "C"]
  }
];
---

<Layout
  title="Muhammet Hüseyin Arbağ — Havacılık Elektrik-Elektroniği Öğrencisi"
  description="Havacılık elektrik-elektroniği öğrencisi. Tarayıcıda çalışan 9 ATA uçak sistemi simülatörü, aviyonik veri yolu araçları ve deterministik yapay zeka ajan tasarımları."
>
  <!-- HERO SECTION (Asymmetrical Bento Grid with Profile & Systems Vision) -->
  <section class="max-w-6xl mx-auto px-6 mb-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Profile Card (Col 4) -->
      <div class="lg:col-span-4 hardware-card">
        <div class="hardware-card-inner flex flex-col justify-between space-y-6">
          <div class="specular-line"></div>
          
          <!-- Portrait & Status -->
          <div class="space-y-4">
            <div class="relative w-full aspect-[4/5] rounded-xl overflow-hidden border border-white/10 shadow-2xl bg-[#07080b]">
              <img
                src="/profile.webp"
                alt="Muhammet Hüseyin Arbağ"
                class="w-full h-full object-cover object-center filter contrast-105 hover:scale-[1.02] transition-all duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#050506] via-transparent to-transparent opacity-75"></div>
              <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/70 backdrop-blur-md border border-white/10 text-[10px] font-mono text-[#00e676]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#00e676] animate-pulse"></span>
                  STAJ &amp; AR-GE'YE AÇIK
                </span>
                <span class="text-[10px] font-mono text-neutral-300 bg-black/70 backdrop-blur-md px-2 py-0.5 rounded border border-white/10">
                  ERU H.E.E.
                </span>
              </div>
            </div>

            <div>
              <p class="text-xl font-bold text-white tracking-tight">Muhammet Hüseyin Arbağ</p>
              <p class="text-xs text-[#00e5ff] font-mono mt-0.5 font-semibold">Havacılık E&amp;E Öğrencisi</p>
              <p class="text-[11px] text-neutral-400 mt-2 leading-relaxed">
                Erciyes Üniversitesi Havacılık Elektrik &amp; Elektroniği (3. Sınıf). Aviyonik simülasyon, Linux sistemleri ve deterministik yapay zeka ajan tasarımı üzerine çalışıyorum.
              </p>
            </div>
          </div>

          <!-- Quick Action Buttons -->
          <div class="pt-2 border-t border-white/[0.06] flex items-center justify-between text-xs font-mono">
            <a href="#ozgecmis" class="text-neutral-300 hover:text-white flex items-center gap-1 font-medium">
              <span>Özgeçmiş (CV)</span>
              <span class="text-[#00e5ff]">↓</span>
            </a>
            <a href="mailto:muhammet@arbag.dev" class="text-neutral-400 hover:text-[#00e5ff] transition-colors">
              muhammet@arbag.dev
            </a>
          </div>
        </div>
      </div>

      <!-- Primary Statement Bento (Col 8) -->
      <div class="lg:col-span-8 hardware-card">
        <div class="hardware-card-inner flex flex-col justify-between">
          <div class="specular-line"></div>
          
          <div class="space-y-6">
            <!-- Eyebrow Tag -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#00e5ff]/30 bg-[#00e5ff]/10">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00e5ff]"></span>
              <span class="mono-telemetry text-[10px] text-[#00e5ff] font-bold">
                AVİYONİK SİMÜLASYON // DETERMİNİSTİK AI // SİSTEM YAZILIMI
              </span>
            </div>

            <!-- Main Heading -->
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-[1.14]">
              Tarayıcıda çalışan aviyonik simülatörler ve deterministik yapay zeka ajanları.
            </h1>

            <!-- Narrative Paragraph -->
            <p class="text-neutral-300 text-sm sm:text-base leading-relaxed max-w-2xl">
              Elektrik, yakıt, hidrolik, bleed air, otomatik uçuş, radyo seyrüsefer ve motor sistemleri için
              <strong class="text-white">9 etkileşimli ATA eğitim laboratuvarı</strong> geliştirdim. Laboratuvarlar arıza senaryoları,
              rehberli deneyler ve basitleştirilmiş bir fizik modeli içerir; kaynak kodları GitHub'da.
            </p>

            <p class="text-neutral-400 text-xs sm:text-sm leading-relaxed max-w-2xl">
              Havacılık elektrik-elektroniği disiplinimin getirdiği donanım bilinciyle; kodun yalnızca ideal senaryoda çalıştığı anla değil; 
              veri yolu gecikmelerinde, frekans dalgalanmalarında, bellek sınırlarında ve kritik kısıtlar altında nasıl davrandığıyla ilgilenirim.
            </p>
          </div>

          <!-- CTAs & Action Ribbon -->
          <div class="pt-8 flex flex-wrap items-center gap-3.5">
            <a
              href="/lab/"
              class="group relative inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full border border-[#00e5ff]/40 bg-[#00e5ff]/15 hover:bg-[#00e5ff]/25 active:scale-[0.98] transition-all text-xs font-semibold text-white tracking-tight shadow-[0_0_15px_rgba(0,229,255,0.2)]"
            >
              <span>Canlı Simülasyon Laboratuvarı</span>
              <span class="text-[#00e5ff] group-hover:translate-x-0.5 transition-transform" aria-hidden="true">→</span>
            </a>

            <a
              href="#yazilim-ai"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full text-xs font-semibold text-neutral-200 hover:text-white border border-white/10 hover:border-[#00e5ff]/40 bg-white/[0.04] hover:bg-white/[0.08] transition-all font-mono"
            >
              <span>Yapay Zeka &amp; Sistemler</span>
              <span class="text-[#00e5ff]" aria-hidden="true">↓</span>
            </a>

            <a
              href="#ozgecmis"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full text-xs font-medium text-neutral-400 hover:text-white border border-transparent hover:border-white/10 transition-colors"
            >
              <span>Özgeçmiş</span>
              <span class="text-neutral-600 font-mono">/ CV</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Secondary Bento 1: AI Architectural Pillars (Col 6) -->
      <div class="lg:col-span-6 hardware-card">
        <div class="hardware-card-inner space-y-4">
          <div class="specular-line"></div>
          
          <div class="flex items-center justify-between border-b border-white/[0.05] pb-2 text-[10px] mono-telemetry text-neutral-400">
            <span class="text-[#00e5ff] font-bold">01 // YAPAY ZEKA VE AJAN FELSEFESİ</span>
            <span>HERMES &amp; AVENOX</span>
          </div>

          <div class="space-y-3 font-mono text-xs">
            <div class="flex items-start gap-2.5">
              <span class="text-[#00e5ff] font-bold mt-0.5">▹</span>
              <div>
                <strong class="text-white">Deterministik Grunt vs. Judgment:</strong>
                <p class="text-[11px] text-neutral-400 mt-0.5">Veri toplamayı LLM yerine saf betiklerle yapıp, modele yalnızca damıtılmış sentez bırakma mimarisi.</p>
              </div>
            </div>

            <div class="flex items-start gap-2.5">
              <span class="text-[#00e5ff] font-bold mt-0.5">▹</span>
              <div>
                <strong class="text-white">Draft-Gate Onay Mekanizması:</strong>
                <p class="text-[11px] text-neutral-400 mt-0.5">Dış dünyaya etki eden mutasyonların operatör makbuzu olmadan gerçekleşmesini engelleyen emniyet kapısı.</p>
              </div>
            </div>

            <div class="flex items-start gap-2.5">
              <span class="text-[#00e5ff] font-bold mt-0.5">▹</span>
              <div>
                <strong class="text-white">Kural Tabanlı Karar Destek Prototipi:</strong>
                <p class="text-[11px] text-neutral-400 mt-0.5">QRH ve arıza ağacı prosedürlerinden esinlenen, LLM içermeyen kural ağacı. Eğitim amaçlıdır, sertifikalı değildir.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Secondary Bento 2: Low-Level Systems Pillars (Col 6) -->
      <div class="lg:col-span-6 hardware-card">
        <div class="hardware-card-inner space-y-4">
          <div class="specular-line"></div>
          
          <div class="flex items-center justify-between border-b border-white/[0.05] pb-2 text-[10px] mono-telemetry text-neutral-400">
            <span class="text-[#00e676] font-bold">02 // SİSTEM YAZILIMI &amp; DONANIM</span>
            <span>LINUX &amp; EMBEDDED</span>
          </div>

          <div class="space-y-3 font-mono text-xs">
            <div class="flex items-start gap-2.5">
              <span class="text-[#00e676] font-bold mt-0.5">▹</span>
              <div>
                <strong class="text-white">Gömülü Linux &amp; Çekirdek:</strong>
                <p class="text-[11px] text-neutral-400 mt-0.5">POSIX paylaşımlı bellek, soket IPC boru hatları ve FreeRTOS gerçek zamanlı görev zamanlaması.</p>
              </div>
            </div>

            <div class="flex items-start gap-2.5">
              <span class="text-[#00e676] font-bold mt-0.5">▹</span>
              <div>
                <strong class="text-white">Kısıtlı Cihazlar &amp; Donanım:</strong>
                <p class="text-[11px] text-neutral-400 mt-0.5">Düşük bellekli cihazlarda (Tizen TV) uygulama geliştirme; UART, SPI ve I2C ile donanım hata ayıklama.</p>
              </div>
            </div>

            <div class="flex items-start gap-2.5">
              <span class="text-[#00e676] font-bold mt-0.5">▹</span>
              <div>
                <strong class="text-white">Aviyonik Veri Yolları (ARINC / 1553B):</strong>
                <p class="text-[11px] text-neutral-400 mt-0.5">Havacılık standartlarında veri yolu protokollerinin yazılımsal ve sayısal işaret (DSP) analizi.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 03 // CANLI SİMÜLASYON VE AVİYONİK LABORATUVARI VİTRİNİ -->
  <section class="max-w-6xl mx-auto px-6 mb-32">
    <div class="hardware-card">
      <div class="hardware-card-inner p-8 lg:p-10 space-y-8">
        <div class="specular-line"></div>

        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
          <div class="space-y-4 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#00e5ff]/30 bg-[#00e5ff]/10 text-[#00e5ff] font-mono text-[10px] font-bold">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00e5ff] animate-ping"></span>
              <span>AYRI SEKMEDE CANLI ÇALIŞAN DENEY MERKEZİ</span>
            </div>

            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight leading-tight">
              Canlı Aviyonik &amp; Donanım Simülasyon Laboratuvarı
            </h2>

            <p class="text-neutral-300 text-sm leading-relaxed">
              Ağır test araçlarını bağımsız bir laboratuvar sayfasına taşıdım.
              Doğrudan tarayıcıda çalışan <strong>PFD kokpit göstergesi</strong>, <strong>32-bit ARINC 429 çözücü</strong>,
              <strong>ARK-04 VTOL geçiş simülatörü</strong>, <strong>QRH kontrol listesi prototipi</strong>,
              <strong>ADS-B çerçeve çözücü</strong> ve
              <strong>9 ATA uçak sistemi</strong> laboratuvarını keşfedin.
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 font-mono text-xs">
              <div class="p-2.5 rounded-lg bg-black/50 border border-white/10">
                <div class="text-[10px] text-neutral-400">KOKPİT</div>
                <div class="font-bold text-white mt-0.5">Canlı PFD</div>
              </div>
              <div class="p-2.5 rounded-lg bg-black/50 border border-white/10">
                <div class="text-[10px] text-neutral-400">VERİ YOLU</div>
                <div class="font-bold text-[#00e5ff] mt-0.5">ARINC 429</div>
              </div>
              <div class="p-2.5 rounded-lg bg-black/50 border border-white/10">
                <div class="text-[10px] text-neutral-400">AERODİNAMİK</div>
                <div class="font-bold text-amber-400 mt-0.5">VTOL Tilt Sim</div>
              </div>
              <div class="p-2.5 rounded-lg bg-black/50 border border-white/10">
                <div class="text-[10px] text-neutral-400">EMNİYET</div>
                <div class="font-bold text-[#00e676] mt-0.5">QRH Copilot</div>
              </div>
            </div>
          </div>

          <!-- Direct Link to /lab -->
          <div class="flex flex-col items-center justify-center space-y-4 lg:min-w-[280px]">
            <a
              href="/lab/"
              class="w-full group relative inline-flex items-center justify-center gap-3 px-6 py-4 rounded-2xl border border-[#00e5ff]/50 bg-[#00e5ff]/15 hover:bg-[#00e5ff]/25 active:scale-[0.98] transition-all text-sm font-bold text-white shadow-[0_0_30px_rgba(0,229,255,0.25)] font-mono text-center"
            >
              <span>Canlı Laboratuvara Git</span>
              <span class="text-[#00e5ff] group-hover:translate-x-1 transition-transform">→</span>
            </a>
            <p class="text-[10px] font-mono text-neutral-400 text-center">
              9 ATA Laboratuvarı • Tarayıcıda, sunucusuz çalışır
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 // YAPAY ZEKA VE AJAN SİSTEMLERİ -->
  <section id="yazilim-ai" class="max-w-6xl mx-auto px-6 mb-32 scroll-mt-24">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 border-b border-white/[0.06] pb-6">
      <div>
        <div class="mono-telemetry text-[11px] text-[#00e5ff] font-semibold mb-2">01 // YAPAY ZEKA VE AJAN SİSTEMLERİ</div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Deterministik LLM Ajanları &amp; Karar Motorları</h2>
      </div>
      <p class="text-xs text-neutral-400 max-w-md font-mono">
        LLM'leri kestirilemez birer sohbet robotu olmaktan çıkarıp, görev-kritik sistem standartlarında deterministik birer mühendislik aracına dönüştüren mimariler.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {aiProjects.map((p) => (
        <div class="hardware-card group">
          <div class="hardware-card-inner flex flex-col justify-between space-y-6">
            <div class="specular-line"></div>

            <div class="space-y-4">
              <div class="flex items-center justify-between text-[10px] font-mono border-b border-white/[0.06] pb-3">
                <span class="text-[#00e5ff] font-bold">{p.tag}</span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#00e5ff]"></span>
              </div>

              <h3 class="text-base font-bold text-white group-hover:text-[#00e5ff] transition-colors leading-snug">
                {p.title}
              </h3>

              <p class="text-xs text-neutral-400 leading-relaxed">
                {p.desc}
              </p>
            </div>

            <div class="space-y-4 pt-4 border-t border-white/[0.05]">
              <!-- Metrics / Highlights -->
              <div class="grid grid-cols-3 gap-2 text-center font-mono">
                {p.metrics.map((m) => (
                  <div class="p-1.5 rounded bg-white/[0.03] border border-white/5 text-[9px] text-[#00e676] font-semibold">
                    {m}
                  </div>
                ))}
              </div>

              <!-- Tech Badges -->
              <div class="flex flex-wrap gap-1.5 pt-1">
                {p.tech.map((t) => (
                  <span class="px-2 py-0.5 rounded bg-black/40 border border-white/10 text-[10px] font-mono text-neutral-300">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 02 // GÖMÜLÜ SİSTEMLER VE DÜŞÜK SEVİYE YAZILIM -->
  <section id="gomulu-sistem" class="max-w-6xl mx-auto px-6 mb-32 scroll-mt-24">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 border-b border-white/[0.06] pb-6">
      <div>
        <div class="mono-telemetry text-[11px] text-[#00e676] font-semibold mb-2">02 // GÖMÜLÜ SİSTEMLER VE DÜŞÜK SEVİYE YAZILIM</div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Linux, C &amp; Donanım</h2>
      </div>
      <p class="text-xs text-neutral-400 max-w-md font-mono">
        Kısıtlı bellekli cihazlar, Mode-S / ADS-B çerçeve çözümleme ve Linux sistem programlama üzerine çalışmalar.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {systemsProjects.map((p) => (
        <div class="hardware-card group">
          <div class="hardware-card-inner flex flex-col justify-between space-y-6">
            <div class="specular-line"></div>

            <div class="space-y-4">
              <div class="flex items-center justify-between text-[10px] font-mono border-b border-white/[0.06] pb-3">
                <span class="text-[#00e676] font-bold">{p.tag}</span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#00e676]"></span>
              </div>

              <h3 class="text-base font-bold text-white group-hover:text-[#00e676] transition-colors leading-snug">
                {p.title}
              </h3>

              <p class="text-xs text-neutral-400 leading-relaxed">
                {p.desc}
              </p>
            </div>

            <div class="space-y-4 pt-4 border-t border-white/[0.05]">
              <!-- Metrics / Highlights -->
              <div class="grid grid-cols-3 gap-2 text-center font-mono">
                {p.metrics.map((m) => (
                  <div class="p-1.5 rounded bg-white/[0.03] border border-white/5 text-[9px] text-cyan-300 font-semibold">
                    {m}
                  </div>
                ))}
              </div>

              <!-- Tech Badges -->
