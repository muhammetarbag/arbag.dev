  <!-- Interactive Fault Injection Script for ATA 24 Synoptic -->
  <script>
    const tripBtn = document.getElementById('trip-idg-btn');
    const resetBtn = document.getElementById('reset-bus-btn');
    const idg1Status = document.getElementById('idg1-status');
    const idg1Volts = document.getElementById('idg1-volts');
    const ac1Source = document.getElementById('ac1-source');
    const btcStatus = document.getElementById('btc-status');
    const faultLog = document.getElementById('fault-log');

    if (tripBtn && resetBtn) {
      tripBtn.addEventListener('click', () => {
        if (idg1Status && idg1Volts && ac1Source && btcStatus && faultLog) {
          idg1Status.innerText = 'TRIPPED (OFF)';
          idg1Status.className = 'text-[10px] px-1.5 py-0.5 rounded bg-red-500/20 text-red-400 font-bold';
          idg1Volts.innerText = '0V AC (KAYIP)';
          ac1Source.innerText = 'BTC Üzerinden IDG 2 Besliyor';
          ac1Source.className = 'text-amber-400 font-bold';
          btcStatus.innerText = 'KAPALI (TRANSFER YAPILDI)';
          btcStatus.className = 'text-sm font-bold text-amber-400';
          faultLog.innerHTML = '<span class="text-amber-400 font-bold">UYARI:</span> IDG 1 düştü! 15ms içinde Bus Tie kapandı, yük atma (Load Shed) devreye alındı.';
        }
      });

      resetBtn.addEventListener('click', () => {
        if (idg1Status && idg1Volts && ac1Source && btcStatus && faultLog) {
          idg1Status.innerText = 'ONLINE';
          idg1Status.className = 'text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-[#00e676] font-bold';
          idg1Volts.innerText = '115V AC • 400 Hz';
          ac1Source.innerText = 'IDG 1 Doğrudan Besliyor';
          ac1Source.className = 'text-[#00e676] font-bold';
          btcStatus.innerText = 'AÇIK (NORMAL İZOLE)';
          btcStatus.className = 'text-sm font-bold text-neutral-300';
          faultLog.innerText = 'DURUM: Tüm baralar nominal ve dengeli besleniyor.';
        }
      });
    }
  </script>
