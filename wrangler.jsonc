{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arbag-dev",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "arbag.dev", "custom_domain": true },
    { "pattern": "www.arbag.dev", "custom_domain": true }
  ]
}
